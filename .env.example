# PhishNet Backend Configuration

# ==================== SERVER ====================
NODE_ENV=development
PORT=3000
APP_NAME=PhishNet

# ==================== FRONTEND URL ====================
# Backend API URL - Set this in your HTML file before loading config.js
# <script>
#   window.API_BASE_URL = 'http://localhost:3000';  // Development
#   window.API_BASE_URL = 'https://your-backend.onrender.com';  // Production
# </script>
FRONTEND_URL=http://localhost:5000

# ==================== DATABASE ====================
# MongoDB Connection String (if using database)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/phishnet?retryWrites=true&w=majority

# ==================== JWT & SECURITY ====================
JWT_SECRET=your_jwt_secret_key_here_change_in_production_min_32_chars
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_here_change_in_production

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== PHISHING DETECTION MODEL ====================
# Use local model path (recommended) or HuggingFace hosted
LOCAL_MODEL_PATH=./PhishingDistilBERT
MODEL_PATH=Gaykar/PhishingDistilBERT

# ==================== EMAIL CONFIGURATION ====================
# For password reset and email verification (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ==================== LOGGING & BACKUP ====================
LOG_LEVEL=info
LOG_FILE=logs/app.log
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_INTERVAL=24

# ==================== THIRD-PARTY APIs (Optional) ====================
# Chatbot Configuration
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=AIzaSyDa4F2bK4tG3j1d9hK7xOcLuJ3-cAzDGic
OPENAI_MODEL=gpt-4o-mini
CHATBOT_ENABLED=true
