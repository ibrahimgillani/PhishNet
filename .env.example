# Frontend Application Configuration

# Backend API URL - Set this in your HTML file before loading config.js
# Add this script tag before config.js in your HTML:
# <script>
#   window.API_BASE_URL = 'http://localhost:3000';  // Development
#   // OR
#   window.API_BASE_URL = 'https://your-backend.onrender.com';  // Production
# </script>
# <script src="config.js"></script>

# Default: http://localhost:3000

# Application
NODE_ENV=development
APP_NAME=PhishNet

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# Email Configuration (for password reset, verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for email links and CORS)
FRONTEND_URL=http://localhost:3000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Backup
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_INTERVAL=24

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5000
SESSION_SECRET=your_session_secret_here

# Chatbot Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
CHATBOT_ENABLED=true
